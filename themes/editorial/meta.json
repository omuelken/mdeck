{
  "name": "Editorial",
  "fonts": [
    "https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700;1,900&family=Lora:ital,wght@0,400;0,600;1,400;1,600&display=swap"
  ],
  "params": {
    "primaryColor":    { "token": "--accent",      "default": "#B83A1A" },
    "backgroundColor": { "token": "--bg",           "default": "#FAFAF7" },
    "inkColor":        { "token": "--ink",          "default": "#111009" },
    "mutedColor":      { "token": "--muted",        "default": "#7A7568" },
    "fontDisplay":     { "token": "--font-display", "default": "\"Playfair Display\", Georgia, \"Times New Roman\", serif" },
    "fontBody":        { "token": "--font-body",    "default": "\"Lora\", Georgia, \"Times New Roman\", serif" }
  }
}
