{
  "name": "mdeck",
  "version": "0.1.0",
  "type": "module",
  "description": "Markdown-driven slide deck framework with swappable design systems",
  "bin": {
    "mdeck": "./bin/mdeck.js"
  },
  "scripts": {
    "test": "node --test",
    "test:browser": "node tools/browser-check.mjs",
    "docs": "node bin/mdeck.js docs",
    "docs:build": "node docs/site/build.js",
    "dev": "node bin/mdeck.js dev",
    "present": "node bin/mdeck.js present",
    "edit": "node bin/mdeck.js edit",
    "build": "node bin/mdeck.js build",
    "preview": "node bin/mdeck.js preview",
    "playground": "vite --config playground/vite.config.js",
    "playground:build": "vite build --config playground/vite.config.js"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "katex": "^0.16.46",
    "marked": "^12.0.0",
    "marked-katex-extension": "^5.1.8",
    "preact": "^10.23.0",
    "prismjs": "^1.29.0",
    "qrcode": "^1.5.4",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.8.1",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0"
  }
}
